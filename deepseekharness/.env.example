# Copy to .env and fill in. Real env vars take precedence over this file.
DEEPSEEK_API_KEY=sk-your-key-here
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_THINKING=off          # on = thinking mode for every call unless --no-reason
# DEEPSEEK_EFFORT=high           # low | high | max
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_SESSION=default
# DEEPSEEK_COMPACT_AT=100000
# DEEPSEEK_KEEP_RECENT=20000
# DEEPSEEK_MAX_TOKENS=8192
